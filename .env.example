CONTROL_USER=operador
CONTROL_PASSWORD=
VIDEO_USER=receptor
VIDEO_PASSWORD=
OUTPUT_FPS=30
ANIMATION_FPS=30
JPEG_QUALITY=74
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
CAMERA_DURATION_MS=1600
PANEL_DURATION_MS=520
PNT_DURATION_MS=520
MAX_HTTP_CONNECTIONS=24
# Optional 60 FPS: OUTPUT_FPS=60 and ANIMATION_FPS=60; measure before broadcast.

# Exact-quality faster JPEG; use qt as a compatibility fallback.
JPEG_ENCODER=pillow
CAPTURE_BACKEND=direct
OUTPUT_DELAY_FRAMES=0.85
# Profiling is for diagnostics, disabled in production by default.
OUTPUT_PROFILE=0

# Linux only; choose allowed idle host CPUs after profiling, otherwise leave blank.
RENDER_CPU_AFFINITY=
